/*
  Template for the password of the network the board creates.

  This file is the one that goes in the repository. It does not hold the real
  password: it only tells whoever clones the project what needs to be created.

  To use it:
    1. copy this file as credentials.h, in the same folder
    2. replace the password with one of 8 to 63 characters
    3. upload as usual

  credentials.h is blocked in .gitignore and never goes to GitHub. The
  repository is public, so a password in the code would be visible to anyone,
  and deleting it later does not help: it stays in the git history.
*/

#ifndef CREDENTIALS_H
#define CREDENTIALS_H

const char *AP_PASSWORD = "replace with a password of 8 to 63 characters";

#endif
